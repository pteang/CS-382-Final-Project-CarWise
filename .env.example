# At least one LLM provider is needed for the final grounded-answer demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional local alternative. Install Ollama separately and pull a model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local embedding model used for vector search.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Default offline generation model used when no API key is available.
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
